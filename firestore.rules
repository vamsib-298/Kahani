rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile, progress, and transactions
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow read/write for transactions sub-collection
      match /transactions/{txId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Allow read/write for notifications sub-collection
      match /notifications/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Allow read/write for downloads sub-collection
      match /downloads/{downloadId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public story catalog
    match /series/{seriesId} {
      allow read: if true;
      // Authenticated users can create stories or edit their OWN stories.
      // Admin can edit ANY story.
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.uploaderId == request.auth.uid || request.auth.token.email == 'dutypein@gmail.com');

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Public reports collection
    match /reports/{reportId} {
      allow read: if request.auth != null && request.auth.token.email == 'dutypein@gmail.com';
      allow create: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.email == 'dutypein@gmail.com';
    }
  }
}
