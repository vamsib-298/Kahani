rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // User profile images: Publicly readable, owner can write
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Public story assets (audio/thumbnails): Everyone can read, authenticated users can write for setup
    match /stories/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
